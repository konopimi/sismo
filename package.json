{
  "name": "sismo-api",
  "version": "1.0.0",
  "description": "https://sismoinfo.co — emergency reporting backend + frontend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild matrix-entry.js --bundle --format=iife --outfile=public/matrix-bundle.js --minify --platform=browser --loader:.wasm=file --external:crypto --external:path --external:fs",
    "build:watch": "esbuild matrix-entry.js --bundle --format=iife --outfile=public/matrix-bundle.js --minify --platform=browser --loader:.wasm=file --external:crypto --external:path --external:fs --watch"
  },
  "dependencies": {
    "express": "^5.2.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "matrix-js-sdk": "^42.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konopimi/sismo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/konopimi/sismo/issues"
  },
  "homepage": "https://github.com/konopimi/sismo#readme"
}