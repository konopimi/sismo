+
+    function render() {
+      const items = fuzzyFilter(searchInput.value, personsData);
+      if (!items.length) {
+        listEl.innerHTML = `<div class="empty">${personsData.length ? "Sin resultados." : "No hay reportes todavía."}</div>`;
+        return;
