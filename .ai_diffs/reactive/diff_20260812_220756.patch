+          });
+          const metaParts = [];
+          if (item.city) metaParts.push(escapeHtml(item.city));
+          if (item.location) metaParts.push(escapeHtml(item.location));
+          metaParts.push(date);
+          return `
+          <div class="card ${found ? "encontrado" : ""}" data-id="${item.id}" data-type="person">
